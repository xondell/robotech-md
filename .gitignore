!.env.example
!README.md
!package.json
!package-lock.json
!tsconfig.json
!next.config.ts
!next-env.d.ts
!eslint.config.mjs
!postcss.config.mjs

!src/
!src/**
!public/
!public/**
!scripts/
!scripts/**
!supabase/
!supabase/**
!docs/
!docs/**

# Local and generated application state
.env
.env.*
!.env.example
.next/
out/
node_modules/
coverage/
*.tsbuildinfo
.vercel/
.supabase/
supabase/.branches/
supabase/.temp/

